# Headlines come from publishers' RSS feeds and need no key.
# NEWS_SOURCE=rss               # rss | newsapi

# Optional: with a NewsAPI key (https://newsapi.org/register), search covers all of NewsAPI
# instead of the stories in the current feeds. Required for NEWS_SOURCE=newsapi.
NEWS_API_KEY=

# Optional AI for briefs, answers and comparisons. Set one key; without either, BlitzFeed
# uses its built-in summarizer and passage search.
# AI_PROVIDER=auto              # auto | anthropic | groq | off (auto prefers Anthropic when both keys are set)

# Groq, which has a free plan (https://console.groq.com/keys).
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MAX_INPUT_CHARS=6000     # article text sent per brief or answer (about 1,000 words)
# Groq's limits for your plan and model (console.groq.com/settings/limits). BlitzFeed
# plans against GROQ_LIMIT_FRACTION of them and falls back to the built-in versions when they run out.
# GROQ_RPM=30
# GROQ_TPM=8000
# GROQ_RPD=1000
# GROQ_TPD=200000
# GROQ_LIMIT_FRACTION=0.8
# GROQ_BRIEFING_SHARE=0.3       # share of the daily budget kept for the daily briefing
# GROQ_BRIEFING_TTL=3600        # seconds to keep an AI briefing
# GROQ_MAX_WAIT=10              # seconds a brief, answer or comparison may wait for the per-minute limit

# Anthropic (paid, https://console.anthropic.com).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

# Recommended: a long random string used to sign article links. Without it, the key is derived
# from an API key above, or is random (and shared brief links break when the server restarts).
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# DEFAULT_EDITION=us            # us | in
# REDIS_URL=redis://localhost:6379/0   # shared cache + rate limits across processes
# TRUST_PROXY=1                 # set when running behind the Next.js proxy or a load balancer
# CORS_ORIGINS=                 # only needed if browsers call this API directly
# SUMMARIZE_RATE_LIMIT=15/minute;300/day
# ASK_RATE_LIMIT=8/minute;80/day
# COMPARE_RATE_LIMIT=6/minute;60/day
# SEARCH_RATE_LIMIT=30/minute
# FEED_TTL=900
# COMPARE_TTL=21600
# LOG_LEVEL=INFO
