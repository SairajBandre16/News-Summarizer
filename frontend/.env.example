# Where the Next.js server reaches the Flask API (server-side only, never sent to browsers).
# Use 127.0.0.1 rather than localhost on Windows to avoid a slow IPv6 lookup.
BACKEND_URL=http://127.0.0.1:8080

# Public URL of this site, used for share links and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
